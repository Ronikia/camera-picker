{
    "name": "camera-picker/catalog",
    "description": "Camera and lens catalog with use-case based picking",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "vlucas/phpdotenv": "^5.6",
        "opis/json-schema": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/index.php",
        "migrate": "php scripts/migrate.php",
        "import": "php scripts/import.php",
        "seed": "php scripts/import.php database/seeds/",
        "test": "phpunit tests"
    },
    "config": {
        "sort-packages": true
    }
}
